APP_ENV=local
LOG_LEVEL=info
WORKFLOW_DEFAULT_NAME=ebay_mtg_scan
BASE_CURRENCY=EUR

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ebay_workflows
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

ENABLE_EBAY_API=false
EBAY_CLIENT_ID=replace_me
EBAY_CLIENT_SECRET=replace_me
EBAY_USE_SANDBOX=false
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_PAGE_SIZE=50
EBAY_MAX_PAGES_PER_RUN=20
EBAY_REQUESTS_PER_MINUTE=60

SCRYFALL_BULK_URI=https://api.scryfall.com/bulk-data/default-cards
SCRYFALL_BULK_CACHE_PATH=./data/scryfall/default-cards.json
SCRYFALL_SYNC_INTERVAL_HOURS=24
SCRYFALL_REQUESTS_PER_MINUTE=30

CARDMARKET_BULK_FILE_PATH=./data/cardmarket/prices.csv
CARDMARKET_BULK_REFRESH_HOURS=24

IMAGE_CACHE_DIR=./.cache/images
IMAGE_DOWNLOAD_TIMEOUT_MS=20000
OCR_ENGINE=paddleocr
FAISS_INDEX_PATH=./.cache/faiss/index.bin
OPENCLIP_MODEL_NAME=ViT-B-32

GLOBAL_REQUESTS_PER_MINUTE_CAP=90
ENABLE_PROVIDER_POLICY_CHECKS=true
DISABLE_LIVE_API_WRITES=true
