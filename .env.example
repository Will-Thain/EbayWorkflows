APP_ENV=local
LOG_LEVEL=info
WORKFLOW_DEFAULT_NAME=ebay_mtg_scan
BASE_CURRENCY=EUR

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ebay_workflows
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

ENABLE_EBAY_API=false
EBAY_CLIENT_ID=replace_me_production
EBAY_CLIENT_SECRET=replace_me_production
EBAY_SANDBOX_CLIENT_ID=replace_me_sandbox
EBAY_SANDBOX_CLIENT_SECRET=replace_me_sandbox
EBAY_USE_SANDBOX=false
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_PAGE_SIZE=50
EBAY_MAX_PAGES_PER_RUN=20
EBAY_REQUESTS_PER_MINUTE=60

SCRYFALL_BULK_URI=https://api.scryfall.com/bulk-data/default-cards
SCRYFALL_BULK_CACHE_PATH=./data/scryfall/default-cards.json
SCRYFALL_SYNC_INTERVAL_HOURS=24
SCRYFALL_REQUESTS_PER_MINUTE=30

CARDMARKET_BULK_FILE_PATH=./data/cardmarket/prices.csv
CARDMARKET_BULK_REFRESH_HOURS=24

IMAGE_CACHE_DIR=./.cache/images
IMAGE_DOWNLOAD_TIMEOUT_MS=20000
OCR_ENGINE=pytesseract
# Optional; auto-detected on Windows if Tesseract is installed via winget
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
FAISS_INDEX_PATH=./.cache/faiss/index.bin
FAISS_TOP_K=5
FAISS_BUILD_MAX_CARDS=10000
FAISS_INDEX_USE_ART_ZONE=true
FAISS_BUILD_ALL_CARDS=false
OPENCLIP_MODEL_NAME=ViT-B-32
TORCH_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
IMAGE_MIN_REGION_SCORE=0.55
IMAGE_ALLOW_FULL_FRAME_FALLBACK=true
PIPELINE_MAX_IMAGE_WORKERS=4
PIPELINE_MAX_DOWNLOAD_WORKERS=8
PIPELINE_MAX_TITLE_MATCH_WORKERS=12
TITLE_MATCH_PREFILTER_SIZE=512
TITLE_MATCH_SCORE_CUTOFF=65
PHASE2_SKIP_UNCHANGED_LISTINGS=true
PHASE1_SKIP_EXISTING_LISTINGS=true
PHASE1_COMMIT_BATCH_SIZE=50
PHASE1_IMAGE_DOWNLOAD_CHUNK_SIZE=100
PHASE1_REFRESH_AFTER_HOURS=
PHASE5_SKIP_ANALYZED_IMAGES=false
PHASE6_SKIP_ANALYZED_IMAGES=false
IMAGE_DOWNLOAD_REQUESTS_PER_MINUTE=120
PIPELINE_ENFORCE_SINGLE_RUN=true
PIPELINE_LOCK_PATH=./.cache/pipeline.lock
FX_GBP_TO_EUR=1.17
TITLE_MATCH_MIN_SCORE_FOR_PRICING=0.90
TITLE_MATCH_MIN_SCORE_NON_MTG=0.98
PHASE2_SKIP_BULK_LOT_TITLE_MATCH=true
IMAGE_EVIDENCE_MIN_OCR_SIMILARITY=0.60
IMAGE_EVIDENCE_MIN_FAISS_SCORE=0.55
IMAGE_EVIDENCE_MIN_MANA_CONFIDENCE=0.30
CARDMARKET_MAX_UNIT_PRICE_EUR=250
EV_MAX_LISTING_COST_MULTIPLE=10
PHASE6_BULK_LISTINGS_ONLY=true
PHASE6_MIN_LOT_DETECTIONS=2
PHASE6_MAX_LOT_EV_MULTIPLE=50
PHASE6_USE_FAISS_CROP_MATCH=true
CARDMARKET_CONDITION_MULTIPLIER_NM=1.0
CARDMARKET_CONDITION_MULTIPLIER_LP=0.85
CARDMARKET_CONDITION_MULTIPLIER_MP=0.70
CARDMARKET_CONDITION_MULTIPLIER_HP=0.55
CARDMARKET_CONDITION_MULTIPLIER_DMG=0.40
CARDMARKET_CONDITION_MULTIPLIER_UNSPECIFIED=0.95
CARD_ZONE_OCR_ENABLED=true
CARD_ZONE_FAISS_ENABLED=true
CARD_ZONE_ALIGN_ENABLED=true
CARD_SET_SYMBOL_MATCH_ENABLED=true
CARD_SET_SYMBOL_MIN_SCORE=0.45
CARD_MANA_COST_ENABLED=true
ALIGN_MIN_CONFIDENCE=0.35
VERIFY_NAME_HARD_MIN=0.75
VERIFY_NAME_STRONG_MIN=0.88
VERIFY_SYMBOL_STRONG_MIN=0.55
FAISS_PROPOSE_CANDIDATES=true

GLOBAL_REQUESTS_PER_MINUTE_CAP=90
ENABLE_PROVIDER_POLICY_CHECKS=true
DISABLE_LIVE_API_WRITES=true
