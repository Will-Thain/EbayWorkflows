{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LabeledCropManifest",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "verify_expect"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "expected_set": { "type": "string" },
          "expected_collector": { "type": "string" },
          "expected_name": { "type": "string" },
          "verify_expect": { "type": "string", "enum": ["pass", "fail"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
